def FugledeTarget.spectralPair : {d : ℕ} → Set (Fin d → ℝ) → Set (Fin d → ℝ) → Prop :=
fun {d} Ω Λ =>
  MeasureTheory.NullMeasurableSet Ω MeasureTheory.volume ∧
    0 < MeasureTheory.volume Ω ∧
      ∃ (hΩ_finite : MeasureTheory.volume Ω ≠ ⊤),
        have e := fun ξ => MeasureTheory.MemLp.toLp (FugledeTarget.exponentialCharacter ξ) ⋯;
        (∀ ξ₁ ∈ Λ, ∀ ξ₂ ∈ Λ, ξ₁ ≠ ξ₂ → inner ℂ (e ξ₁) (e ξ₂) = 0) ∧
          (Submodule.span ℂ (Set.range fun ξ => e ↑ξ)).topologicalClosure = ⊤
def FugledeTarget.FugledeConjectureFor : ℕ → Prop :=
fun d =>
  ∀ (Ω : Set (Fin d → ℝ)),
    Bornology.IsBounded Ω →
      MeasurableSet Ω → 0 < MeasureTheory.volume Ω → (FugledeTarget.isSpectral Ω ↔ FugledeTarget.tilesByTranslation Ω)
def FugledeTarget.CompleteTwoDimensionalTarget : Prop :=
¬FugledeTarget.FugledeConjectureFor 2
